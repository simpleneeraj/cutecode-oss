    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^14.14.0",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@cutecode/config": "*",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^5.1.1"
