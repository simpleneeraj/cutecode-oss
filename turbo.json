{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {},
    "lint": {},
    "test:unit": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "size": {}
  }
}
